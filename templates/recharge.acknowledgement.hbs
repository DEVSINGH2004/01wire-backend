<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <title>Recharge Invoice</title>
    <style>
      body {
        font-family: "Inter";
      }
      .container {
        height: auto;
        background-color: rgba(242, 245, 248, 1);
        padding: 32px;
      }
      .rechargeInvoice {
        height: auto;
        padding: 32px;
        background-color: rgba(255, 255, 255, 1);
        border-radius: 4px 4px 0 0;
      }
      .rechargeInvoice span {
        font-size: 16px;
        font-weight: 400;
        color: rgba(51, 51, 51, 1);
        display: block;
      }
      .balanceBox {
        height: 67px;
        padding: 8px, 16px, 8px, 16px;
        border-radius: 4px;
        background-color: rgba(240, 242, 245, 1);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .footer {
        height: 216px;
        background-color: rgba(247, 249, 252, 1);
        padding: 32px;
        border-radius: 0 0 4px 4px;
      }
      .footer span {
        font-size: 14px;
        font-weight: 400;
        display: block;
        color: rgba(51, 51, 51, 1);
      }
      h6,
      h5 {
        margin: 0px !important;
      }
      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo img {
        width: 100px;
        height: auto;
      }
      .social-icons {
        display: flex;
      }
      .social-icon {
        margin-right: 10px;
      }

      .social-icon img {
        width: 30px;
        height: auto;
      }
      .header {
        height: 117.37px;
        padding: 24px 32px;
      }
      @media screen and (max-width: 768px) {
        h1 {
          font-size: 1.5rem;
        }
        .container,
        .rechargeInvoice,
        .footer {
          padding: 10px;
        }
        .footer span {
          font-size: 10px;
        }
        .rechargeInvoice span {
          font-size: 14px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="header">
        <img
          height="69px"
          width="139px"
          src="data:image/png;base64,"
        />
      </header>
      <div class="rechargeInvoice">
        <h1 style="color: rgba(249, 86, 92, 1)">Recharge Invoice</h1>
        <div style="margin: 20px 0px">
          <span>Hi,</span>
          <span
            >Your recharge of {{credits}} credits has been successfully completed.Your total account balance
            is:</span
          >
        </div>
        <div class="balanceBox">
          <div style="display: flex; align-items: center">
            <h1 style="margin-right: 15px">{{balance}}</h1>
            <span>Credits</span>
          </div>
        </div>
        <span style="margin-top: 20px !important">Date: 27 Feb 2023 , 10:32AM(GMT)</span>
      </div>
      <footer class="footer">
        <span style="margin: 40px 0px !important"
          >Thank you for choosing One Wire. If you have any questions regarding this invoice or need
          further assistance, please don't hesitate to contact us at
          <span style="color: rgba(249, 86, 92, 1)">contact@01wire.com</span></span
        >
        <div class="footer-content">
          <div class="logo">
            <img
              src="data:image/png;base64,"
              alt="Website Logo"
            />
          </div>
          <div class="social-icons">
            <a href="https://www.facebook.com/" class="social-icon"
              ><img
                src="https://upload.wikimedia.org/wikipedia/commons/5/51/Facebook_f_logo_%282019%29.svg"
                alt="Facebook"
            /></a>
            <a href="https://twitter.com/" class="social-icon"
              ><img src="https://cdn-icons-png.flaticon.com/512/5968/5968830.png" alt="Twitter"
            /></a>
            <a href="https://www.linkedin.com/" class="social-icon"
              ><img
                src="https://upload.wikimedia.org/wikipedia/commons/c/ca/LinkedIn_logo_initials.png"
                alt="LinkedIn"
            /></a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
